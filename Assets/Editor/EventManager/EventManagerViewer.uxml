<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement class="event-viewer">
        <!-- 统一主工具栏 -->
        <uie:Toolbar class="event-toolbar">
            <ui:Label text="Event Manager Viewer" class="toolbar-title" />
            <uie:ToolbarButton name="CategoryFilterButton" text="Category: All ▾" />
            <ui:VisualElement class="toolbar-spacer" />
            <uie:ToolbarToggle name="ShowRegisterToggle" text="Register" />
            <uie:ToolbarToggle name="ShowUnregisterToggle" text="Unregister" />
            <uie:ToolbarToggle name="ShowBroadcastToggle" text="Broadcast" />
            <uie:ToolbarButton name="ColumnsButton" text="Columns ▾" />
            <uie:ToolbarButton name="RefreshButton" text="Refresh" />
        </uie:Toolbar>

        <!-- 提示和状态区域 -->
        <ui:Label name="NoticeLabel" class="notice-label" />
        <ui:Label name="StatusLabel" class="status-label" />

        <!-- 采用 TwoPaneSplitView 支持交互式拖拽 -->
        <ui:TwoPaneSplitView name="SplitView" class="main-layout" orientation="horizontal" fixed-pane-index="0" fixed-pane-initial-dimension="560">
            <!-- 左侧面板：事件总表 -->
            <ui:VisualElement class="left-pane">
                <ui:MultiColumnListView name="EventList" class="table-view" />
            </ui:VisualElement>

            <!-- 右侧面板：双 Tab 面板 -->
            <ui:VisualElement class="right-pane">
                <!-- Tab 控制头部 -->
                <ui:VisualElement class="tabs-container">
                    <ui:Button name="ListenersTabButton" text="Listeners &amp; Details" class="tab-button tab-button--active" />
                    <ui:Button name="HistoryTabButton" text="Broadcast History" class="tab-button" />
                </ui:VisualElement>

                <!-- Tab 1 内容：当前选中事件的监听器与详情 -->
                <ui:VisualElement name="ListenersTabContent" class="tab-content tab-content--active">
                    <!-- 事件详情卡片 -->
                    <ui:VisualElement class="detail-card">
                        <ui:Label text="Selected Event Details" class="detail-title" />
                        <ui:Label name="EventDetailLabel" class="detail-text" />
                    </ui:VisualElement>

                    <!-- 监听者列表标题与角标 -->
                    <ui:VisualElement class="sublist-header">
                        <ui:Label text="Active Listeners" class="sublist-title" />
                        <ui:Label name="ListenersCountBadge" text="0" class="sublist-badge" />
                    </ui:VisualElement>
                    
                    <!-- 监听者多列列表 -->
                    <ui:MultiColumnListView name="ListenerList" class="table-view" />
                </ui:VisualElement>

                <!-- Tab 2 内容：历史广播记录与受影响监听者 -->
                <ui:VisualElement name="HistoryTabContent" class="tab-content">
                    <!-- 历史日志头部 -->
                    <ui:VisualElement class="sublist-header">
                        <ui:Label text="Broadcast Logs" class="sublist-title" />
                        <ui:Label name="LogsCountBadge" text="0" class="sublist-badge" />
                        <ui:VisualElement class="toolbar-spacer" />
                        <ui:Toggle name="SelectedEventOnlyToggle" text="Selected Event Only" style="margin-right: 8px; font-size: 10px;" />
                        <ui:Button name="SelectLastCallButton" text="Locate Last Call" class="small-button" />
                    </ui:VisualElement>
                    
                    <!-- 历史日志列表 -->
                    <ui:MultiColumnListView name="LogList" class="table-view" style="flex-grow: 1; min-height: 180px;" />

                    <!-- 受影响监听器头部 -->
                    <ui:VisualElement class="sublist-header" style="margin-top: 8px;">
                        <ui:Label text="Affected Listeners (Selected Log)" class="sublist-title" />
                        <ui:Label name="AffectedCountBadge" text="0" class="sublist-badge" />
                    </ui:VisualElement>
                    
                    <!-- 受影响监听器列表 -->
                    <ui:MultiColumnListView name="AffectedList" class="table-view" style="flex-grow: 0; height: 130px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
