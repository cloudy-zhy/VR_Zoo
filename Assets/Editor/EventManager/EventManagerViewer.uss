/* EventManagerViewer Premium Dark Geek Style */

.event-viewer {
    flex-grow: 1;
    background-color: #191919;
    color: #e2e8f0;
}

/* Toolbar Styling */
.event-toolbar {
    background-color: #242424;
    border-bottom-width: 1px;
    border-bottom-color: #2e2e2e;
    min-height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    align-items: center;
}

.toolbar-title {
    -unity-font-style: bold;
    color: #38bdf8; /* Neon blue accent */
    font-size: 12px;
    margin-right: 12px;
}

.toolbar-spacer {
    flex-grow: 1;
}

/* Notice & Status */
.notice-label {
    margin: 6px 8px 4px 8px;
    padding: 6px 12px;
    border-left-width: 4px;
    border-left-color: #fb923c; /* Amber warning */
    background-color: #2b241e;
    color: #ffedd5;
    border-radius: 3px;
    font-size: 11px;
}

.status-label {
    margin: 4px 8px 6px 8px;
    padding: 4px 8px;
    background-color: #1e293b;
    border-left-width: 4px;
    border-left-color: #38bdf8;
    color: #cbd5e1;
    font-size: 11px;
    border-radius: 3px;
}

/* Main Split Layout */
.main-layout {
    flex-grow: 1;
    margin: 0 8px 8px 8px;
}

.left-pane {
    flex-grow: 1;
    min-width: 320px;
    background-color: #1f1f1f;
    border-width: 1px;
    border-color: #2d2d2d;
    border-radius: 4px;
    overflow: hidden;
}

.right-pane {
    flex-grow: 1;
    min-width: 480px;
    background-color: #1f1f1f;
    border-width: 1px;
    border-color: #2d2d2d;
    border-radius: 4px;
    overflow: hidden;
}

/* Tabs UI */
.tabs-container {
    flex-direction: row;
    background-color: #262626;
    border-bottom-width: 1px;
    border-bottom-color: #2d2d2d;
    min-height: 28px;
}

.tab-button {
    flex-grow: 1;
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: transparent;
    color: #94a3b8;
    -unity-font-style: bold;
    padding: 4px 12px;
    border-radius: 0;
    margin: 0;
}

.tab-button:hover {
    background-color: #2d2d2d;
    color: #e2e8f0;
}

.tab-button--active {
    color: #38bdf8;
    border-bottom-color: #38bdf8;
    background-color: #1f1f1f;
}

.tab-content {
    flex-grow: 1;
    display: none;
    padding: 8px;
}

.tab-content--active {
    display: flex;
}

/* Card Detail Box */
.detail-card {
    padding: 10px;
    background-color: #15181c;
    border-left-width: 4px;
    border-left-color: #4ade80; /* Emerald Green default */
    border-top-width: 1px;
    border-top-color: #262930;
    border-right-width: 1px;
    border-right-color: #262930;
    border-bottom-width: 1px;
    border-bottom-color: #262930;
    border-radius: 4px;
    margin-bottom: 8px;
}

.detail-title {
    -unity-font-style: bold;
    color: #f8fafc;
    font-size: 11px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: #262930;
    padding-bottom: 4px;
}

.detail-text {
    color: #cbd5e1;
    font-size: 11px;
    margin-bottom: 3px;
    white-space: normal;
}

.detail-highlight {
    color: #38bdf8;
    -unity-font-style: bold;
}

/* MultiColumnListView Custom Styling */
.table-view {
    flex-grow: 1;
    background-color: #1a1a1a;
    border-width: 1px;
    border-color: #2d2d2d;
    border-radius: 3px;
}

/* Native MultiColumnListView Header */
.table-view .unity-multi-column-header {
    background-color: #262626;
    border-bottom-width: 1px;
    border-bottom-color: #2d2d2d;
    -unity-font-style: bold;
    color: #e2e8f0;
}

.table-view .unity-multi-column-header__column {
    border-right-width: 1px;
    border-right-color: #2d2d2d;
    padding: 4px 6px;
}

/* Table rows styling */
.table-view .unity-list-view__item:hover {
    background-color: #2d3748;
}

.table-view .unity-list-view__item--selected {
    background-color: #1a365d;
    color: #ffffff;
}

/* Alternate Rows */
.row-even {
    background-color: #1d1d1d;
}

.row-odd {
    background-color: #161616;
}

/* Table cells custom labels styling */
.cell-text {
    font-size: 11px;
    color: #cbd5e1;
    padding: 3px 6px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

/* Header Text Alignments & Types */
.cell-align-right {
    -unity-text-align: middle-right;
}

.cell-align-center {
    -unity-text-align: middle-center;
}

/* State colors */
.color-broadcast {
    color: #38bdf8; /* Neon blue */
    -unity-font-style: bold;
}

.color-register {
    color: #4ade80; /* Emerald green */
    -unity-font-style: bold;
}

.color-unregister {
    color: #fb923c; /* Amber orange */
    -unity-font-style: bold;
}

.color-warning {
    color: #f87171; /* Warn red */
    -unity-font-style: bold;
}

.color-muted {
    color: #64748b;
}

/* Splitter Style */
.unity-two-pane-split-view__drag-line {
    background-color: #2d2d2d;
}

.unity-two-pane-split-view__drag-line-anchor {
    background-color: #4b5563;
}

/* Section titles for sublists inside tabs */
.sublist-header {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 4px;
}

.sublist-title {
    -unity-font-style: bold;
    color: #94a3b8;
    font-size: 11px;
}

.small-button {
    background-color: #334155;
    color: #e2e8f0;
    border-width: 0;
    border-radius: 3px;
    padding: 2px 8px;
    font-size: 10px;
}

.small-button:hover {
    background-color: #475569;
}

/* Header Dropdown Button Styling */
.header-dropdown-btn {
    cursor: link;
}

.header-dropdown-btn:hover {
    color: #38bdf8 !important; /* Glow neon blue on hover */
}
