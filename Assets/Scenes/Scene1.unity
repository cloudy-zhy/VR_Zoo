    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[1].dialogueText
      value: "\u628A\u5B83\u653E\u5230\u5F39\u5F13\u4E0A\uFF0C\u677E\u5F00\u63E1\u628A\u952E\u653E\u4E0A\u53BB\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[2].dialogueText
      value: "\u518D\u6B21\u6309\u4F4F\u63E1\u628A\u952E\u6293\u4F4F\u5B83\uFF0C\u7528\u529B\u5411\u540E\u62C9\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[3].dialogueText
      value: "\u4ED4\u7EC6\u7784\u51C6\u90A3\u9897\u5927\u679C\u5B50\uFF0C\u5343\u4E07\u522B\u677E\u624B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[4].dialogueText
      value: "\u597D\uFF01\u73B0\u5728\u677E\u5F00\u63E1\u628A\u952E\uFF0C\u53D1\u5C04\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[5].dialogueText
      value: "\u51FB\u843D\u679C\u5B50\u83B7\u5F97\u4E00\u5B9A\u5206\u6570\u8FDB\u5165\u4E0B\u4E00\u4E2A\u6311\u6218"
