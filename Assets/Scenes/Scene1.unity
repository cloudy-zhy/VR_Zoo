    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[6].dialogueText
      value: "\u4E0D\u540C\u7684\u679C\u5B50\u6709\u4E0D\u540C\u7684\u5206\u6570"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[7].dialogueText
      value: "\u679C\u5B50\u4E4B\u95F4\u78B0\u649E\u4E5F\u53EF\u4EE5\u51FB\u843D\u679C\u5B50"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[8].dialogueText
      value: "\u4E0D\u9519\u561B\uFF01\u51C6\u5907\u597D\u53BB\u6311\u6218\u66F4\u8FDC\u7684\u6811\u679D\u4E86\u5417\uFF1F\r"
