    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[0].dialogueText
      value: "\u5217\u8F66\u7A7F\u8D8A\u51B0\u539F\u4E0E\u51B0\u7011\u3002\u96EA\u8272\u6E10\u6563\uFF0C\u4E91\u5C42\u4E0B\u65B9\u6D6E\u73B0\u4E00\u7247\u82CD\u7FE0\u7684\u5DE8\u578B\u68EE\u6797\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[1].dialogueText
      value: "\u8F66\u8EAB\u8F7B\u8F7B\u4E0A\u5347\u3002\u8F66\u53A2\u4E24\u4FA7\u5C55\u5F00\u5F69\u8679\u8272\u7684\u4E91\u7FFC\uFF0C\u5F15\u64CE\u58F0\u8F6C\u4E3A\u8F7B\u76C8\u7684\u98CE\u9E23\u2014\u2014\u5217\u8F66\u5316\u4F5C\u5F69\u8679\u98DE\u8247\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[2].dialogueText
      value: "\u98DE\u8247\u8D8A\u8FC7\u5DE8\u578B\u8568\u7C7B\u68EE\u6797\u3001\u78A7\u7EFF\u6E56\u6CCA\u3001\u7011\u5E03\u4E0E\u5F69\u8679\u84B8\u6C7D\u706B\u5C71\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[3].dialogueText
      value: "\u5217\u8F66\u5E7F\u64AD\u54CD\u8D77\uFF1A\u201C\u524D\u65B9\u5230\u7AD9\u2014\u2014\u6050\u9F99\u8C37\u79D8\u5883\u3002\u6050\u9F99\u8C37\u7684\u4F19\u4F34\u4EEC\u4F53\u578B\u5DEE\u5F02\u8F83\u5927\uFF0C\u4F46\u90FD\u5F88\u53CB\u597D\u3002\u8BF7\u52FF\u60CA\u614C\u3002\u201D"
      objectReference: {fileID: 0}
