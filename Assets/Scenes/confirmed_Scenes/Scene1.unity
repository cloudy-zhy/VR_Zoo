    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[0].dialogueText
      value: "\u7528\u5C04\u7EBF\u7784\u51C6\u6E21\u6E21\u9E1F\uFF0C\u63E1\u7D27\u62F3\u5934\u6293\u4F4F\u5B83\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[10].speakerName
      value: "\u8BFA\u4E9A"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[11].speakerName
      value: "\u80D6\u80D6"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[12].speakerName
      value: "\u6E21\u6E21\u9E1F\u914B\u957F"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[1].dialogueText
      value: "\u628A\u5B83\u653E\u5230\u5F39\u5F13\u4E0A\uFF0C\u677E\u5F00\u62F3\u5934\u653E\u4E0A\u53BB\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[2].dialogueText
      value: "\u518D\u6B21\u63E1\u7D27\u62F3\u5934\u6293\u4F4F\u5B83\uFF0C\u7528\u529B\u5411\u540E\u62C9\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[3].dialogueText
      value: "\u4ED4\u7EC6\u7784\u51C6\u90A3\u9897\u5927\u679C\u5B50\uFF0C\u5343\u4E07\u522B\u677E\u624B\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[4].dialogueText
      value: "\u597D\uFF01\u73B0\u5728\u677E\u5F00\u62F3\u5934\uFF0C\u53D1\u5C04\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[5].dialogueText
      value: "\u51FB\u843D\u679C\u5B50\u83B7\u5F97\u4E00\u5B9A\u5206\u6570\u8FDB\u5165\u4E0B\u4E00\u4E2A\u6311\u6218"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[6].dialogueText
      value: "\u4E0D\u540C\u7684\u679C\u5B50\u6709\u4E0D\u540C\u7684\u5206\u6570"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[7].dialogueText
      value: "\u679C\u5B50\u4E4B\u95F4\u78B0\u649E\u4E5F\u53EF\u4EE5\u51FB\u843D\u679C\u5B50"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[8].dialogueText
      value: "\u4E0D\u9519\u561B\uFF01\u51C6\u5907\u597D\u53BB\u6311\u6218\u66F4\u8FDC\u7684\u6811\u679D\u4E86\u5417\uFF1F\r"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[9].dialogueText
      value: "\u5495\u5495\uFF01\u592A\u8C22\u8C22\u4F60\u4E86\uFF01\u679C\u5B9E\u5DF2\u7ECF\u591F\u5566\uFF01\n\u521A\u521A\u2026\u2026\u6211\u4EEC\u597D\u50CF\u4E5F\u98DE\u4E0A\u5929\u7A7A\u4E86\u4E00\u6837\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[10].dialogueText
      value: "\u592A\u68D2\u4E86\uFF01\u6210\u529F\u83B7\u53D6\u661F\u5149\u679C\u5B9E\uFF01\u6E21\u6E21\u9E1F\u4EEC\uFF0C\u76DB\u5178\u4E0A\u89C1\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[11].dialogueText
      value: "\u90A3\u6211\u4EEC\u5148\u8D70\u5566\uFF0C\u5217\u8F66\u8FD8\u5728\u7B49\u7740\u5462\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[12].dialogueText
