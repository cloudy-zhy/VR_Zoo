    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[3].speakerName
      value: "\u8BFA\u8BFA"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[4].speakerName
      value: "\u80D6\u80D6"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[5].speakerName
      value: "\u5C0F\u7FFC\u9F99"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[6].speakerName
      value: "\u5C0F\u7FFC\u9F99"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[0].dialogueText
      value: "\u4F7F\u8005~\u4F60\u771F\u7684\u6765\u5566\uFF01\u6211\u5C31\u77E5\u9053\u6211\u7684\u722A\u5370\u9080\u8BF7\u51FD\u4E00\u5B9A\u80FD\u627E\u5230\u4F60\u4EEC\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[1].dialogueText
      value: "\u4F60\u4EEC\u5FEB\u770B\u4E0A\u9762\uFF01\u6211\u4EEC\u7684\u7FFC\u9F99\u5927\u961F\u5E26\u6765\u4E86\u8FD9\u6B21\u76DB\u5178\u6240\u9700\u7684\u2018\u661F\u5149\u80FD\u91CF\u2019\u3002\u4F46\u8FD9\u4E9B\u80FD\u91CF\u4E00\u843D\u5230\u5730\u4E0A\u5C31\u4F1A\u6D88\u6563\u3002\u6211\u4EEC\u9700\u8981\u4F60\u7528\u2018\u63D0\u706F\u2019\u628A\u5B83\u4EEC\u6536\u96C6\u8D77\u6765\uFF01"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[2].dialogueText
      value: "\u2026\u2026\u6BCF\u5E74\u5230\u8FD9\u4E00\u523B\uFF0C\u6211\u90FD\u89C9\u5F97\u6574\u4E2A\u8C37\u5B50\u90FD\u5728\u5C4F\u6C14\u51DD\u795E\u3002\u8FDE\u6700\u5435\u7684\u526F\u6809\u9F99\u90FD\u4E0D\u53EB\u4E86\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[3].dialogueText
      value: "\u6211\u4EEC\u628A\u4E09\u6837\u90FD\u96C6\u9F50\u4E86\u3002\u679C\u5B9E\u3001\u65CB\u5F8B\u3001\u661F\u5149\u3002\u6700\u540E\u4E00\u6B65\uFF0C\u9700\u8981\u4F60\u6765\u505A\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[4].dialogueText
      value: "\u4F7F\u8005\uFF0C\u4F60\u770B\u3002\u90A3\u91CC\u5C31\u662F\u8FDC\u53E4\u7684\u796D\u575B\u3002\u661F\u5149\u4EEA\u5F0F\u7684\u6700\u540E\u4E00\u6B65\uFF0C\u9700\u8981\u4F60\u4EB2\u624B\u53BB\u5F00\u542F\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[5].dialogueText
      value: "\u5C31\u662F\u8FD9\u91CC\u4E86\u3002\u4F60\u628A\u661F\u5149\u80FD\u91CF\u6C47\u8FDB\u53BB\uFF0C\u4EEA\u5F0F\u5C31\u5F00\u59CB\u4E86\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[6].dialogueText
      value: "\u8FD9\u91CC\u7684\u6BCF\u4E00\u6761\u8F68\u8FF9\uFF0C\u90FD\u662F\u73B0\u5B9E\u4E16\u754C\u91CC\u2026\u2026\u5BF9\u4E00\u79CD\u751F\u547D\u7684\u8BB0\u5FC6\u3002\u4F46\u5982\u679C\u6CA1\u4EBA\u518D\u8BB0\u5F97\u6211\u4EEC\uFF0C\u8FD9\u4E9B\u5149\u2026\u2026\u5C31\u4F1A\u5F7B\u5E95\u7184\u706D\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 8844573248469640820, guid: ff7c2eab641c2dd4f81edf147cd2a752,
        type: 3}
      propertyPath: dialogueSequence.Array.data[0].displayDuration
